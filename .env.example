# Copy to .env and fill in. Never put real values in this file — it is committed.

# Nebius Token Factory (Nemotron calls)
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# ConTree / Sandboxes — the SDK reads these exact variable names
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=

# Tavily
TAVILY_API_KEY=

# Sandbox: "true" runs targets in Token Factory Sandboxes, otherwise a local subprocess
SANDBOX_ALLOWED_EGRESS=api.tokenfactory.nebius.com,api.tavily.com
USE_REAL_SANDBOX=true

# Optional: AUDITOR_OFFLINE=true skips Nemotron/Tavily and uses deterministic payloads/scoring
AUDITOR_OFFLINE=false

# GitHub (only needed for the patch-PR stretch goal)
GITHUB_TOKEN=
